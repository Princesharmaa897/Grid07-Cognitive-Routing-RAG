# ============================================================
# Cognitive Routing & RAG System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ------ OpenAI Configuration ------
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ------ Ollama Configuration (Optional) ------
# Set USE_OLLAMA=true to use a local Ollama instance instead of OpenAI.
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------ Embedding Model ------
# HuggingFace sentence-transformer model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------ Routing ------
# Cosine similarity threshold for persona matching (0.0 – 1.0)
ROUTING_THRESHOLD=0.30

# ------ Logging ------
LOG_LEVEL=INFO
